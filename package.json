{
  "name": "deciphony",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:renderer": "pnpm --filter @deciphony/renderer build",
    "build:player": "pnpm --filter @deciphony/player build",
    "build:extensions": "pnpm --filter @deciphony/extensions build",
    "build:finger": "pnpm --filter @deciphony/finger build",
    "build:pitch-detection": "pnpm --filter @deciphony/pitch-detection build",
    "build:tune-judge": "pnpm build:pitch-detection && pnpm --filter @deciphony/tune-judge build",
    "build:work": "pnpm --filter @deciphony/work build",
    "build:puff": "pnpm --filter @deciphony/puff build",
    "publish:renderer": "pnpm build:renderer && pnpm --filter @deciphony/renderer publish --no-git-checks --registry http://localhost:4873/",
    "publish:player": "pnpm build:player && pnpm --filter @deciphony/player publish --no-git-checks --registry http://localhost:4873/",
    "publish:extensions": "pnpm build:extensions && pnpm --filter @deciphony/extensions publish --no-git-checks --registry http://localhost:4873/",
    "publish:finger": "pnpm build:finger && pnpm --filter @deciphony/finger publish --no-git-checks --registry http://localhost:4873/",
    "publish:pitch-detection": "pnpm build:pitch-detection && pnpm --filter @deciphony/pitch-detection publish --no-git-checks --registry http://localhost:4873/",
    "publish:tune-judge": "pnpm build:tune-judge && pnpm --filter @deciphony/tune-judge publish --no-git-checks --registry http://localhost:4873/",
    "publish:work": "pnpm build:work && pnpm --filter @deciphony/work publish --no-git-checks --registry http://localhost:4873/",
    "publish:puff": "pnpm build:puff && pnpm --filter @deciphony/puff publish --no-git-checks --registry http://localhost:4873/",
    "publish:libs": "pnpm publish:renderer && pnpm publish:player && pnpm publish:extensions && pnpm publish:finger && pnpm publish:pitch-detection && pnpm publish:tune-judge && pnpm publish:work && pnpm publish:puff"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.2.0",
    "@types/three": "^0.167.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^9.27.0",
    "typescript-eslint": "^8.0.1"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "pnpm": "^10.17.1",
    "typescript": "^5.9.2",
    "uuid": "^13.0.2"
  }
}
