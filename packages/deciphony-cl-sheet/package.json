{
  "name": "@deciphony/cl-sheet",
  "version": "0.0.2",
  "description": "和弦弹唱谱（吉他）：歌词 + 和弦的展示与编辑",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/cl-sheet.css": "./dist/cl-sheet.css"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "3.5.18",
    "vue-tsc": "^3.0.5"
  },
  "keywords": [
    "deciphony",
    "chord",
    "lyrics",
    "guitar"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0"
}
