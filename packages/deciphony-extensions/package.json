{
  "name": "@deciphony/extensions",
  "version": "0.0.18",
  "description": "@deciphony/renderer 官方扩展集（标题、歌词、编辑构建、播放、MusicXML/简谱转换等）",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dr-title": {
      "types": "./dist/dr-title/index.d.ts",
      "import": "./dist/dr-title/index.js"
    },
    "./dr-lyrics": {
      "types": "./dist/dr-lyrics/index.d.ts",
      "import": "./dist/dr-lyrics/index.js"
    },
    "./dr-instrument-name": {
      "types": "./dist/dr-instrument-name/index.d.ts",
      "import": "./dist/dr-instrument-name/index.js"
    },
    "./dr-edit": {
      "types": "./dist/dr-edit/index.d.ts",
      "import": "./dist/dr-edit/index.js"
    },
    "./dr-edit/score-builder": {
      "types": "./dist/dr-edit/score-builder.d.ts",
      "import": "./dist/dr-edit/score-builder.js"
    },
    "./dr-play": {
      "types": "./dist/dr-play/index.d.ts",
      "import": "./dist/dr-play/index.js"
    },
    "./dr-play-highlight": {
      "types": "./dist/dr-play-highlight/index.d.ts",
      "import": "./dist/dr-play-highlight/index.js"
    },
    "./dr-time-offset": {
      "types": "./dist/dr-time-offset/index.d.ts",
      "import": "./dist/dr-time-offset/index.js"
    },
    "./dr-musicxml-transfer": {
      "types": "./dist/dr-musicxml-transfer/index.d.ts",
      "import": "./dist/dr-musicxml-transfer/index.js"
    },
    "./dr-midi-transfer": {
      "types": "./dist/dr-midi-transfer/index.d.ts",
      "import": "./dist/dr-midi-transfer/index.js"
    },
    "./dr-midi-record": {
      "types": "./dist/dr-midi-record/index.d.ts",
      "import": "./dist/dr-midi-record/index.js"
    },
    "./dr-mark": {
      "types": "./dist/dr-mark/index.d.ts",
      "import": "./dist/dr-mark/index.js"
    },
    "./dr-score3d": {
      "types": "./dist/dr-score3d/index.d.ts",
      "import": "./dist/dr-score3d/index.js"
    },
    "./dr-numberNotation-transfer": {
      "types": "./dist/dr-numberNotation-transfer/index.d.ts",
      "import": "./dist/dr-numberNotation-transfer/index.js"
    },
    "./dr-quick-numberNotation": {
      "types": "./dist/dr-quick-numberNotation/index.d.ts",
      "import": "./dist/dr-quick-numberNotation/index.js"
    },
    "./chord-builder": {
      "types": "./dist/chord-builder/index.d.ts",
      "import": "./dist/chord-builder/index.js"
    },
    "./audio-to-score": {
      "types": "./dist/audio-to-score/index.d.ts",
      "import": "./dist/audio-to-score/index.js"
    },
    "./score-util": {
      "types": "./dist/score-util.d.ts",
      "import": "./dist/score-util.js"
    },
    "./css": {
      "import": "./dist/extensions.css"
    }
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@deciphony/player": "*",
    "@deciphony/renderer": "*",
    "fast-xml-parser": "^5.0.0",
    "three": ">=0.160.0",
    "vue": "^3.3.0",
    "xmlbuilder": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deciphony/player": "workspace:*",
    "@deciphony/renderer": "workspace:*",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "fast-xml-parser": "^5.8.0",
    "sass": "^1.83.0",
    "three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.3.4",
    "vue-tsc": "^3.0.5",
    "xmlbuilder": "^15.1.1"
  },
  "keywords": [
    "deciphony",
    "extensions"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.14.0"
}
