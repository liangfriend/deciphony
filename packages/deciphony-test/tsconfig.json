{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    // 不允许使用ts扩展名
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "paths": {
      "vue": [
        "./node_modules/vue"
      ],
      "@deciphony/renderer": [
        "../deciphony-renderer/src/index.ts"
      ],
      "@deciphony/work": [
        "../deciphony-work/src/index.ts"
      ],
      "@deciphony/extensions": [
        "../deciphony-extensions/src/index.ts"
      ],
      "@deciphony/extensions/*": [
        "../deciphony-extensions/src/*"
      ],
      "@deciphony/finger": [
        "../deciphony-finger/src/index.ts"
      ],
      "@deciphony/puff": [
        "../deciphony-puff/src/index.ts"
      ],
      "j-player": [
        "../j-player/src/index.ts"
      ],
      "@deciphony/player": [
        "../deciphony-player/src/index.ts"
      ],
      "@deciphony/ui": [
        "../deciphony-ui/src/index.ts"
      ],
      "@deciphony/core": [
        "../deciphony-core/src/index.ts"
      ],
      "@deciphony/core/utils": [
        "../deciphony-core/src/utils/*.ts"
      ],
      "@assets/*": [
        "../deciphony-ui/src/assets/*"
      ],
      "@/*": [
        "../deciphony-renderer/src/*"
      ]
    }
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
