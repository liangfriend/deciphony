{
  "name": "@deciphony/work",
  "version": "0.0.15",
  "description": "sjw 课件展示与产出",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/work.css": "./dist/work.css"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@deciphony/renderer": "*",
    "@deciphony/player": "*",
    "@deciphony/extensions": "*"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@deciphony/renderer": "workspace:*",
    "@deciphony/player": "workspace:*",
    "@deciphony/extensions": "workspace:*",
    "sass": "^1.83.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "3.5.18",
    "vue-tsc": "^3.0.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0"
}
